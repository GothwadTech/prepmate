# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==========================================
# Firebase Configuration
# (Found in Firebase Console > Project Settings > General > Your apps > Web app)
# ==========================================
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# [OPTIONAL] Google Analytics Measurement ID
# If you did NOT check "Enable Google Analytics" in Firebase Console,
# Firebase does not provide a measurementId. It is 100% safe to leave this EMPTY ("").
VITE_FIREBASE_MEASUREMENT_ID=""

# [OPTIONAL / RTDB] Firebase Realtime Database URL
# Required if using Firebase Realtime Database (RTDB) alongside Firestore.
# Example: https://your-project-id-default-rtdb.firebaseio.com (or asia-southeast1 / us-central1)
# Note: Cloud Firestore only needs VITE_FIREBASE_PROJECT_ID above.
VITE_FIREBASE_DATABASE_URL=""

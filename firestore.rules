rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. User profile documents
    match /users/{userId} {
      // Authenticated users can view profiles for partner search, leaderboard, and comparison
      allow read: if isAuthenticated();
      // Only the user themselves can create or update their profile
      allow create, update: if isOwner(userId);
      allow delete: if false; // Profiles cannot be deleted without admin intervention
    }

    // 2. Daily tasks collection
    match /tasks/{taskId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 3. Study goals collection
    match /goals/{goalId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 4. Partner Requests (Invite, Accept, Reject)
    match /partner_requests/{requestId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        resource.data.fromUserId == request.auth.uid || 
        resource.data.toUserId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.fromUserId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.toUserId == request.auth.uid || 
        resource.data.fromUserId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        resource.data.fromUserId == request.auth.uid || 
        resource.data.toUserId == request.auth.uid
      );
    }

    // 5. Active Partnerships
    match /partnerships/{partnershipId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        request.auth.uid in resource.data.members
      );
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.members;
      allow update, delete: if isAuthenticated() && request.auth.uid in resource.data.members;
    }

    // 6. Daily Logs & Activity Heatmap Data
    match /daily_logs/{logId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 7. Notification Center & Alerts (Phase 15)
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated(); // Allow partner cheer triggers
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 8. Partner Study Challenges & Duels
    match /partner_challenges/{challengeId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 9. Partner Cheers
    match /partner_cheers/{cheerId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }
  }
}
